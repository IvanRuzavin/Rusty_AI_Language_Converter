{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusty-ai-language-converter.local/schemas/rendered-package.schema.json",
  "title": "RenderedPackage",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1"},
    "catalog_id": {"type": "string", "minLength": 1},
    "package_name": {"type": "string", "minLength": 1},
    "output_name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "output_directory": {"type": "string", "minLength": 1},
    "source_archive_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "request_context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prompt_version": {"type": "string", "minLength": 1},
    "model_id": {"type": "string", "minLength": 1},
    "response_id": {"type": "string", "minLength": 1},
    "required_rust_crates": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "enum": ["Cargo.toml", "library.rs", "main.rs", "mikrobus.rs"]
          },
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "required": ["path", "sha256", "size_bytes"],
        "additionalProperties": false
      }
    },
    "total_size_bytes": {"type": "integer", "minimum": 0},
    "api_coverage_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "model-output.schema.json#/$defs/coverageEntry"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "reused_existing": {"type": "boolean"}
  },
  "required": [
    "schema_version",
    "catalog_id",
    "package_name",
    "output_name",
    "output_directory",
    "source_archive_sha256",
    "request_context_sha256",
    "prompt_version",
    "model_id",
    "response_id",
    "required_rust_crates",
    "files",
    "total_size_bytes",
    "api_coverage_ledger",
    "assumptions",
    "warnings",
    "reused_existing"
  ],
  "additionalProperties": false
}
