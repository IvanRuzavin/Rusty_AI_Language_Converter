{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusty-ai-language-converter.local/schemas/model-output.schema.json",
  "title": "ModelOutput",
  "type": "object",
  "properties": {
    "schema_version": {"const": "1"},
    "library_rs": {"type": "string", "minLength": 1},
    "main_rs": {"type": "string", "minLength": 1},
    "required_rust_crates": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "api_coverage_ledger": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/coverageEntry"}
    },
    "assumptions": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "unsupported_items": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "library_rs",
    "main_rs",
    "required_rust_crates",
    "api_coverage_ledger",
    "assumptions",
    "warnings",
    "unsupported_items"
  ],
  "additionalProperties": false,
  "$defs": {
    "coverageEntry": {
      "type": "object",
      "properties": {
        "source_symbol": {"type": "string", "minLength": 1},
        "source_kind": {
          "enum": [
            "function",
            "struct",
            "union",
            "enum",
            "typedef",
            "macro",
            "global",
            "resource"
          ]
        },
        "status": {
          "enum": [
            "translated",
            "replaced_by_rust_construct",
            "private_internal",
            "not_applicable",
            "unsupported"
          ]
        },
        "rust_symbol": {"type": ["string", "null"]},
        "rationale": {"type": "string", "minLength": 1}
      },
      "required": [
        "source_symbol",
        "source_kind",
        "status",
        "rust_symbol",
        "rationale"
      ],
      "additionalProperties": false
    }
  }
}
