{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusty-ai-language-converter.local/schemas/cached-archive.schema.json",
  "title": "CachedArchive",
  "description": "A validated Click package archive in the local content cache.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "package": {
      "$ref": "package-record.schema.json"
    },
    "archive_path": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "cache_hit": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "package",
    "archive_path",
    "sha256",
    "size_bytes",
    "cache_hit"
  ],
  "additionalProperties": false
}
