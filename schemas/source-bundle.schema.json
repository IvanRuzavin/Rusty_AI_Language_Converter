{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rusty-ai-language-converter.local/schemas/source-bundle.schema.json",
  "title": "SourceBundle",
  "description": "Canonical UTF-8 inputs and resource metadata selected from a Click archive.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "inventory": {
      "$ref": "package-inventory.schema.json"
    },
    "manifest": {
      "$ref": "#/$defs/packageManifest"
    },
    "examples": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exampleMetadata"
      }
    },
    "text_files": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceTextFile"
      }
    },
    "resource_files": {
      "type": "array",
      "items": {
        "$ref": "archive-file.schema.json"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "inventory",
    "manifest",
    "examples",
    "text_files",
    "resource_files",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "manifestLibrary": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string",
          "minLength": 1
        },
        "subdir_name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["alias", "subdir_name", "path"],
      "additionalProperties": false
    },
    "packageManifest": {
      "type": "object",
      "properties": {
        "manifest_path": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "package_name": {
          "type": "string",
          "minLength": 1
        },
        "package_type": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "product_id": {
          "type": ["string", "null"]
        },
        "libraries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/manifestLibrary"
          }
        },
        "example_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "manifest_path",
        "display_name",
        "package_name",
        "package_type",
        "version",
        "product_id",
        "libraries",
        "example_paths"
      ],
      "additionalProperties": false
    },
    "exampleMetadata": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "toolchains": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hardware": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": ["path", "name", "toolchains", "hardware"],
      "additionalProperties": false
    },
    "sourceTextFile": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "enum": [
            "package_manifest",
            "example_metadata",
            "driver_header",
            "driver_source",
            "driver_assembly",
            "example_source",
            "build_metadata",
            "documentation"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "content": {
          "type": "string"
        }
      },
      "required": ["path", "purpose", "sha256", "size_bytes", "content"],
      "additionalProperties": false
    }
  }
}
